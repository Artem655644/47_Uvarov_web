<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>КАЗИНО РХТУ</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: radial-gradient(circle at top, #2b0055 0%, #070014 60%, #000 100%);
      color: #fff;
      line-height: 1.4;
      overflow-x: hidden;
      transition: background 0.3s ease, color 0.3s ease;
    }

    @keyframes blink {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: .25; }
    }

    @keyframes glow {
      0% { filter: drop-shadow(0 0 0 rgba(255,255,255,0)); }
      50% { filter: drop-shadow(0 0 12px rgba(255,230,0,.85)); }
      100% { filter: drop-shadow(0 0 0 rgba(255,255,255,0)); }
    }

    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-2px); }
      50% { transform: translateX(2px); }
      75% { transform: translateX(-1px); }
      100% { transform: translateX(0); }
    }

    @keyframes slideUp {
      from { transform: translateY(120%); }
      to { transform: translateY(0); }
    }

    @keyframes slideInRight {
      from { transform: translateX(110%); }
      to { transform: translateX(0); }
    }

    @keyframes iconBlink {
      0%, 45% { opacity: 1; transform: scale(1); }
      50%, 100% { opacity: 0; transform: scale(0.9); }
    }

    .toast .icon {
      display: inline-block;
      margin-right: 6px;
      animation: iconBlink 0.9s infinite;
    }

    .toast.t1 .icon { animation-duration: 0.7s; }
    .toast.t2 .icon { animation-duration: 0.9s; }
    .toast.t3 .icon { animation-duration: 1.1s; }

    header {
      background: linear-gradient(90deg, #ff00cc, #00d4ff, #ffe600, #ff00cc);
      border-bottom: 5px solid #ffe600;
      padding: 14px 12px;
      text-shadow: 2px 2px 0 #000;
      position: sticky;
      top: 0;
      z-index: 50;
      animation: glow 1.2s infinite;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .topbar {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: #000;
      border: 3px solid #ffe600;
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #ffe600;
      animation: blink .6s infinite, shake .9s infinite;
    }

    .brand h1 {
      margin: 0;
      font-size: 18px;
      letter-spacing: 1px;
    }

    .brand small {
      display: block;
      font-size: 12px;
      opacity: 0.95;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 10px 12px;
      border-radius: 10px;
      border: 2px solid #000;
      background: #ffe600;
      color: #000;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 0 16px rgba(255,230,0,.55);
      animation: glow 1.1s infinite;
    }

    .btn:hover { background: #00d4ff; }

    .btn-danger {
      background: #ff00cc;
      color: #fff;
      border-color: #000;
      box-shadow: 0 0 18px rgba(255,0,204,.55);
      animation: blink .5s infinite, shake .8s infinite;
    }

    .theme-toggle {
      position: fixed;
      right: 16px;
      bottom: 95px;
      z-index: 120;
      padding: 12px 16px;
      border: 2px solid #000;
      border-radius: 12px;
      background: #00d4ff;
      color: #000;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 0 18px rgba(0,212,255,.45);
    }

    .ticker {
      background: #000;
      border-top: 2px dashed #00d4ff;
      border-bottom: 2px dashed #00d4ff;
      padding: 8px 0;
      overflow: hidden;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .ticker span {
      display: inline-block;
      padding-left: 100%;
      white-space: nowrap;
      font-weight: 900;
      color: #00d4ff;
      text-shadow: 0 0 10px rgba(0,212,255,.7);
      animation: tickerMove 10s linear infinite;
    }

    @keyframes tickerMove {
      0% { transform: translateX(0); }
      100% { transform: translateX(-120%); }
    }

    main {
      max-width: 1100px;
      margin: 14px auto 70px;
      padding: 0 12px;
      display: grid;
      grid-template-columns: 230px 1fr 230px;
      gap: 12px;
      align-items: start;
    }

    aside {
      position: sticky;
      top: 96px;
      background: rgba(255,255,255,0.06);
      border: 2px dashed #00d4ff;
      border-radius: 14px;
      padding: 10px;
      box-shadow: 0 0 18px rgba(0,212,255,.25);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .ad {
      background: #000;
      border-radius: 14px;
      border: 3px solid #ff00cc;
      padding: 10px;
      margin-bottom: 10px;
      animation: blink 1s infinite;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .ad:nth-child(2) { border-color: #ffe600; animation-duration: .7s; }
    .ad:nth-child(3) { border-color: #00d4ff; animation-duration: .5s; }

    .ad h3 {
      margin: 0 0 6px;
      font-size: 14px;
      color: #ffe600;
      text-shadow: 0 0 10px rgba(255,230,0,.8);
    }

    .ad p {
      margin: 0 0 8px;
      font-size: 13px;
      opacity: .95;
    }

    .ad .mini {
      font-size: 11px;
      opacity: .75;
    }

    .content {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    article {
      background: rgba(255,255,255,0.08);
      border: 2px solid rgba(255,255,255,0.16);
      border-radius: 16px;
      padding: 14px;
      box-shadow: 0 0 20px rgba(255,0,204,.18);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    article > h2 {
      margin: 0 0 10px;
      font-size: 20px;
      color: #00d4ff;
      text-shadow: 0 0 12px rgba(0,212,255,.55);
      border-bottom: 2px dashed rgba(0,212,255,.6);
      padding-bottom: 6px;
      animation: blink 1.2s infinite;
    }

    section {
      border: 2px solid rgba(255,230,0,.35);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 10px;
      background: rgba(0,0,0,0.35);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    section:last-child { margin-bottom: 0; }

    section > h3 {
      margin: 0 0 8px;
      font-size: 16px;
      color: #ffe600;
      text-shadow: 0 0 10px rgba(255,230,0,.55);
      animation: glow 1.1s infinite;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 10px;
      align-items: center;
      border-color: rgba(255,0,204,.7);
      box-shadow: 0 0 18px rgba(255,0,204,.35);
    }

    .badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    .badge {
      padding: 6px 10px;
      border-radius: 999px;
      background: #000;
      border: 2px solid #00d4ff;
      color: #00d4ff;
      font-weight: 900;
      font-size: 12px;
      animation: blink .9s infinite;
    }

    .slot {
      background: #000;
      border: 3px solid #00d4ff;
      border-radius: 14px;
      padding: 10px;
      text-align: center;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .slotRow {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
    }

    .reel {
      width: 72px;
      height: 72px;
      border-radius: 12px;
      border: 3px solid #ffe600;
      display: grid;
      place-items: center;
      font-size: 34px;
      background: linear-gradient(180deg, #1a0033, #000);
      animation: shake .5s infinite;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .sloganGrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .slogan {
      background: linear-gradient(90deg, #ff0000, #ff00cc, #00d4ff);
      border: 3px solid #000;
      border-radius: 12px;
      padding: 10px;
      font-weight: 900;
      text-align: center;
      text-shadow: 2px 2px 0 #000;
      animation: blink .6s infinite;
    }

    ol { margin: 0; padding-left: 20px; }
    li { margin: 8px 0; }

    .reviews-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }

    .review-card {
      background: #000;
      border: 3px solid #ffe600;
      border-radius: 14px;
      padding: 10px;
      box-shadow: 0 0 14px rgba(255,230,0,.25);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .review-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .review-avatar {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #00d4ff;
      background: #111;
      flex-shrink: 0;
    }

    .review-name {
      color: #00d4ff;
      font-weight: 900;
      word-break: break-word;
    }

    .review-text {
      margin: 6px 0 0;
      word-break: break-word;
    }

    .review-date {
      display: block;
      margin-top: 8px;
      font-size: 12px;
      opacity: 0.75;
    }

    .review-form {
      display: grid;
      gap: 10px;
    }

    .review-form label {
      font-weight: 700;
      color: #ffe600;
    }

    .review-form input,
    .review-form textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      border: 2px solid #00d4ff;
      background: rgba(255,255,255,0.1);
      color: #fff;
      font: inherit;
      outline: none;
    }

    .review-form textarea {
      min-height: 110px;
      resize: vertical;
    }

    .review-form input::placeholder,
    .review-form textarea::placeholder {
      color: rgba(255,255,255,0.7);
    }

    .form-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .error-message,
    .success-message {
      min-height: 24px;
      font-weight: 700;
    }

    .error-message { color: #ff9090; }
    .success-message { color: #9cff9c; }

    .popupOverlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      display: none;
      z-index: 100;
    }

    .popupOverlay:target { display: block; }

    .popup {
      max-width: 520px;
      margin: 10vh auto;
      background: #000;
      border: 5px solid #ff00cc;
      border-radius: 16px;
      padding: 14px;
      box-shadow: 0 0 30px rgba(255,0,204,.5);
      animation: shake .8s infinite;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .popup h2 {
      margin: 0 0 8px;
      color: #ffe600;
      text-shadow: 0 0 12px rgba(255,230,0,.7);
      animation: blink .5s infinite;
    }

    .popup p { margin: 0 0 10px; }

    .popup .row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .closeLink {
      display: inline-block;
      padding: 10px 12px;
      border-radius: 10px;
      border: 2px solid #000;
      background: #00d4ff;
      color: #000;
      font-weight: 900;
      text-decoration: none;
    }

    .bottomBar {
      position: fixed;
      left: 10px;
      right: 10px;
      bottom: 10px;
      z-index: 60;
      background: linear-gradient(90deg, #ff00cc, #ffe600, #00d4ff);
      border: 4px solid #000;
      border-radius: 14px;
      padding: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      animation: slideUp .4s ease-out, blink .7s infinite;
      box-shadow: 0 0 22px rgba(255,230,0,.35);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .bottomBar b { color: #000; }
    .bottomBar small { color: #000; font-weight: 900; }

    .toast {
      position: fixed;
      right: 12px;
      top: 120px;
      z-index: 70;
      width: 260px;
      background: #000;
      border: 3px solid #00d4ff;
      border-radius: 14px;
      padding: 10px;
      box-shadow: 0 0 18px rgba(0,212,255,.35);
      animation: slideInRight .35s ease-out;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .toast h4 {
      margin: 0 0 6px;
      font-size: 13px;
      color: #ffe600;
      animation: blink .7s infinite;
    }

    .toast p { margin: 0; font-size: 12px; opacity: .92; }

    .t1 { animation-delay: 0s; }
    .t2 { top: 215px; border-color: #ff00cc; }
    .t3 { top: 310px; border-color: #ffe600; }

    .dark-theme {
      background: radial-gradient(circle at top, #f7f0ff 0%, #dcefff 50%, #ffffff 100%);
      color: #111;
    }

    .dark-theme header {
      background: linear-gradient(90deg, #4dd8ff, #fff59d, #ff9de0, #4dd8ff);
      border-bottom-color: #111;
      text-shadow: none;
      color: #111;
    }

    .dark-theme .logo {
      background: #fff;
      color: #111;
      border-color: #111;
    }

    .dark-theme .ticker {
      background: #f6f6f6;
      border-top-color: #444;
      border-bottom-color: #444;
    }

    .dark-theme .ticker span {
      color: #004f75;
      text-shadow: none;
    }

    .dark-theme aside {
      background: rgba(255,255,255,0.85);
      border-color: #444;
      box-shadow: 0 0 18px rgba(0,0,0,.08);
    }

    .dark-theme article {
      background: rgba(255,255,255,0.88);
      border-color: rgba(0,0,0,0.15);
      box-shadow: 0 0 18px rgba(0,0,0,.08);
    }

    .dark-theme article > h2 {
      color: #0b5b7a;
      text-shadow: none;
      border-bottom-color: rgba(0,0,0,0.2);
    }

    .dark-theme section {
      background: rgba(255,255,255,0.9);
      border-color: rgba(0,0,0,0.18);
    }

    .dark-theme section > h3,
    .dark-theme .ad h3,
    .dark-theme .popup h2 {
      color: #7a4e00;
      text-shadow: none;
    }

    .dark-theme .ad,
    .dark-theme .slot,
    .dark-theme .review-card,
    .dark-theme .popup,
    .dark-theme .toast {
      background: #ffffff;
      color: #111;
    }

    .dark-theme .review-name {
      color: #0b5b7a;
    }

    .dark-theme .review-avatar {
      border-color: #7a4e00;
      background: #f0f0f0;
    }

    .dark-theme .badge {
      background: #fff;
      color: #004f75;
      border-color: #004f75;
    }

    .dark-theme .reel {
      background: linear-gradient(180deg, #ffffff, #f1f1f1);
      border-color: #7a4e00;
    }

    .dark-theme .review-form input,
    .dark-theme .review-form textarea {
      background: #fff;
      color: #111;
      border-color: #555;
    }

    .dark-theme .review-form input::placeholder,
    .dark-theme .review-form textarea::placeholder {
      color: #666;
    }

    .dark-theme .toast p,
    .dark-theme .ad p,
    .dark-theme .popup p,
    .dark-theme .bottomBar small,
    .dark-theme .bottomBar b {
      color: #111;
    }

    .dark-theme .bottomBar {
      background: linear-gradient(90deg, #b3ecff, #fff1a8, #ffc8ea);
      border-color: #444;
      animation: slideUp .4s ease-out;
    }

    .dark-theme .btn {
      border-color: #444;
    }

    @media (max-width: 980px) {
      main { grid-template-columns: 1fr; }
      aside { position: static; }
      .toast { display: none; }
      .theme-toggle { bottom: 110px; }
    }

    @media (max-width: 600px) {
      .hero { grid-template-columns: 1fr; }
      .sloganGrid { grid-template-columns: 1fr; }
      .actions { width: 100%; }
      .btn { width: 100%; text-align: center; }
      .bottomBar { flex-direction: column; align-items: stretch; }
      .theme-toggle {
        right: 10px;
        left: 10px;
        width: auto;
        text-align: center;
      }
    }

    @media (max-width: 360px) {
      body { font-size: 15px; }
      .reel { width: 64px; height: 64px; font-size: 30px; }
      .brand h1 { font-size: 16px; }
      header { padding: 12px 10px; }
    }
  </style>
</head>

